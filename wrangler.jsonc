{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 이 이름은 클라우드플레어 대시보드의 Worker 이름(주소 맨 앞부분)과 같아야 해요.
  "name": "multiplication-defense",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // 게임 화면 파일: 저장소 맨 위 폴더 그대로 (.assetsignore에 적힌 파일은 빼고)
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // 참여 플레이어 수·누적 판 수를 저장하는 곳 (무료 플랜은 SQLite 방식만 가능)
  "durable_objects": {
    "bindings": [{ "name": "STATS", "class_name": "Stats" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Stats"] }],
  // 로그: 무료 플랜은 하루 20만 건까지 저장 (같은 계정의 다른 게임과 함께 씀).
  // 요청 하나하나가 로그로 남아 금방 차서, 10번 중 1번만 저장 (같은 에러는 여러 번 나므로 원인 찾기에는 충분).
  // 게임 동작과는 상관없음
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
